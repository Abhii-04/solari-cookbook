def ensure_node_manager(command, directory):
    if command in {"npm", "pnpm", "yarn"} and not ensure_node_runtime(directory):
        return False
    if has(command):
        return True
    if command in {"pnpm", "yarn"} and has("corepack"):
        if run(["corepack", "enable", command], directory) == 0 and has(command):
            return True
    if command in {"pnpm", "yarn"} and has("npm"):
        if run(["npm", "install", "-g", command], directory) == 0 and has(command):
            return True
    return False


def has_python_module(module):
    return has("python3") and subprocess.run(
        ["python3", "-m", module, "--version"],
        text=True,
        capture_output=True,
        check=False,
    ).returncode == 0


def uv_command(directory):
    if not ensure_python_runtime(directory):
        return None
    if has("uv"):
        return ["uv"]
    if has_python_module("uv"):
        return ["python3", "-m", "uv"]
    if has("python3"):
        run(["python3", "-m", "pip", "install", "--user", "uv"], directory)
        if has_python_module("uv"):
            return ["python3", "-m", "uv"]
    return None


def create_python_venv(directory):
    interpreters = python_venv_candidates(directory)
    if not interpreters:
        return 1

    commands = []
    if has("uv"):
        commands.append(["uv", "venv", "--python", "3.11"])
        commands.extend([["uv", "venv", "--python", interpreter] for interpreter in interpreters])
    commands.extend([[interpreter, "-m", "venv", ".venv"] for interpreter in interpreters])

    for command in commands:
        status = run(command, directory)
        if status == 0:
            return 0
        if command[1:3] == ["-m", "venv"]:
            if ensure_python_venv_support(directory):
                status = run(command, directory)
                if status == 0:
                    return 0
    return 1


def install_requirement_file(directory, requirements_file):
    if has("uv"):
        command = [
            "uv",
            "pip",
            "install",
            "--python",
            ".venv/bin/python",
            "-r",
            requirements_file.name,
        ]
    else:
        command = [
            ".venv/bin/python",
            "-m",
            "pip",
            "install",
            "-r",
            requirements_file.name,
        ]

    status = run(command, directory)
    if status == 0:
        return 0

    if ensure_python_build_tools(directory):
        print(f"INSTALL_RETRY {requirements_file.name} after python-build-tools", flush=True)
        status = run(command, directory)
    return status
