def run(command, cwd, timeout=900, timeout_ok=False, env=None):
    print(f"$$ {' '.join(command)}", flush=True)
    try:
        result = subprocess.run(
            command,
            cwd=cwd,
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout,
            env=env,
        )
    except subprocess.TimeoutExpired as exc:
        if exc.stdout:
            print(exc.stdout, end="", flush=True)
        if exc.stderr:
            print(exc.stderr, end="", flush=True)
        print(f"TIMEOUT {timeout}", flush=True)
        returncode = 0 if timeout_ok else 124
        print(f"EXIT {returncode}", flush=True)
        return returncode

    if result.stdout:
        print(result.stdout, end="", flush=True)
    if result.stderr:
        print(result.stderr, end="", flush=True)
    print(f"EXIT {result.returncode}", flush=True)
    return result.returncode


def status_label(returncode):
    return "PASS" if returncode == 0 else "FAIL"


def run_logged(phase, command, cwd, timeout=900, timeout_ok=False, env=None):
    print(f"{phase}_COMMAND_BEGIN {' '.join(command)}", flush=True)
    returncode = run(command, cwd, timeout=timeout, timeout_ok=timeout_ok, env=env)
    print(f"{phase}_COMMAND_STATUS {status_label(returncode)} {returncode}", flush=True)
    print(f"{phase}_COMMAND_END {' '.join(command)}", flush=True)
    return returncode


def has(command):
    return subprocess.run(
        ["sh", "-lc", f"command -v {command} >/dev/null 2>&1"]
    ).returncode == 0


def missing_tool(command):
    print(f"MISSING_TOOL {command}", flush=True)


def apt_install(packages, directory):
    if not has("apt-get"):
        return False
    command = ["apt-get", "update"]
    if run(command, directory, timeout=300) != 0:
        return False
    command = ["apt-get", "install", "-y"] + packages
    return run(command, directory, timeout=900) == 0


def bootstrap_tool(tool_name, packages, directory):
    if has(tool_name):
        return True
    print(f"BOOTSTRAP_BEGIN {tool_name}", flush=True)
    ok = apt_install(packages, directory)
    print(f"BOOTSTRAP_END {tool_name} {status_label(0 if ok else 1)}", flush=True)
    return has(tool_name)


def ensure_python_runtime(directory):
    if has("python3"):
        return True
    if bootstrap_tool("python3", ["python3", "python3-pip", "python3-venv"], directory):
        return True
    missing_tool("python3")
    return False


def python_venv_candidates(directory):
    if not ensure_python_runtime(directory):
        return []
    candidates = []
    for command in ["python3.11", "python3.10", "python3.12", "python3"]:
        if has(command) and command not in candidates:
            candidates.append(command)
    return candidates


def ensure_python_build_tools(directory):
    print("BOOTSTRAP_BEGIN python-build-tools", flush=True)
    ok = apt_install(["build-essential", "python3-dev"], directory)
    print(f"BOOTSTRAP_END python-build-tools {status_label(0 if ok else 1)}", flush=True)
    if not ok:
        missing_tool("build-essential")
    return ok


def ensure_python_venv_support(directory):
    print("BOOTSTRAP_BEGIN python-venv", flush=True)
    ok = apt_install(["python3-venv", "python3-pip"], directory)
    print(f"BOOTSTRAP_END python-venv {status_label(0 if ok else 1)}", flush=True)
    if not ok:
        missing_tool("python3-venv")
    return ok


def ensure_node_runtime(directory):
    if has("node") and has("npm"):
        return True
    print("BOOTSTRAP_BEGIN nodejs", flush=True)
    ok = apt_install(["nodejs", "npm"], directory)
    print(f"BOOTSTRAP_END nodejs {status_label(0 if ok else 1)}", flush=True)
    if has("node") and has("npm"):
        return True
    missing_tool("npm")
    return False


def ensure_go_runtime(directory):
    if has("go"):
        return True
    if bootstrap_tool("go", ["golang-go"], directory):
        return True
    missing_tool("go")
    return False


def ensure_rust_runtime(directory):
    if has("cargo"):
        return True
    if bootstrap_tool("cargo", ["cargo"], directory):
        return True
    missing_tool("cargo")
    return False


def ensure_ruby_runtime(directory):
    if has("bundle"):
        return True
    print("BOOTSTRAP_BEGIN bundle", flush=True)
    ok = apt_install(["ruby-full", "ruby-bundler"], directory)
    print(f"BOOTSTRAP_END bundle {status_label(0 if ok else 1)}", flush=True)
    if has("bundle"):
        return True
    missing_tool("bundle")
    return False


def ensure_php_composer(directory):
    if has("composer"):
        return True
    if bootstrap_tool("composer", ["composer", "php-cli"], directory):
        return True
    missing_tool("composer")
    return False


def ensure_node_manager(command, directory):
    if command in {"npm", "pnpm", "yarn"} and not ensure_node_runtime(directory):
        return False
    if has(command):
        return True
    if command in {"pnpm", "yarn"} and has("corepack"):
        if run(["corepack", "enable", command], directory) == 0 and has(command):
            return True
    if command in {"pnpm", "yarn"} and has("npm"):
        if run(["npm", "install", "-g", command], directory) == 0 and has(command):
            return True
    return False


def has_python_module(module):
    return has("python3") and subprocess.run(
        ["python3", "-m", module, "--version"],
        text=True,
        capture_output=True,
        check=False,
    ).returncode == 0


def uv_command(directory):
    if not ensure_python_runtime(directory):
        return None
    if has("uv"):
        return ["uv"]
    if has_python_module("uv"):
        return ["python3", "-m", "uv"]
    if has("python3"):
        run(["python3", "-m", "pip", "install", "--user", "uv"], directory)
        if has_python_module("uv"):
            return ["python3", "-m", "uv"]
    return None


def create_python_venv(directory):
    interpreters = python_venv_candidates(directory)
    if not interpreters:
        return 1

    commands = []
    if has("uv"):
        commands.append(["uv", "venv", "--python", "3.11"])
        commands.extend([["uv", "venv", "--python", interpreter] for interpreter in interpreters])
    commands.extend([[interpreter, "-m", "venv", ".venv"] for interpreter in interpreters])

    for command in commands:
        status = run(command, directory)
        if status == 0:
            return 0
        if command[1:3] == ["-m", "venv"]:
            if ensure_python_venv_support(directory):
                status = run(command, directory)
                if status == 0:
                    return 0
    return 1


def install_requirement_file(directory, requirements_file):
    if has("uv"):
        command = [
            "uv",
            "pip",
            "install",
            "--python",
            ".venv/bin/python",
            "-r",
            requirements_file.name,
        ]
    else:
        command = [
            ".venv/bin/python",
            "-m",
            "pip",
            "install",
            "-r",
            requirements_file.name,
        ]

    status = run(command, directory)
    if status == 0:
        return 0

    if ensure_python_build_tools(directory):
        print(f"INSTALL_RETRY {requirements_file.name} after python-build-tools", flush=True)
        status = run(command, directory)
    return status


def ignored(path):
    return any(
        part in {".git", "node_modules", ".venv", "venv", "dist", "build", "target", "vendor"}
        for part in path.parts
    )


def read_text_safely(path, max_bytes=1_000_000):
    try:
        if path.stat().st_size > max_bytes:
            return None
        return path.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return None


def file_inventory(directory, limit=5000):
    files = []
    total = 0
    for path in sorted(directory.rglob("*")):
        rel = path.relative_to(directory)
        if ignored(rel) or not path.is_file():
            continue
        total += 1
        if len(files) >= limit:
            continue
        files.append(str(rel))
    return {"total": total, "shown": files, "truncated": total > len(files)}


def suspicious_text_reason(text):
    checks = [
        ("curl or wget piped into a shell", ("curl ", "wget "), ("| sh", "| bash", "|bash", "|sh")),
        ("destructive root filesystem removal", ("rm -rf /", "rm -fr /"), ()),
        ("reverse shell pattern", ("nc -e ", "ncat -e ", "bash -i >&", "/dev/tcp/"), ()),
        ("base64 decoded shell execution", ("base64 -d", "base64 --decode"), ("| sh", "| bash", "|bash", "|sh")),
        ("chmod 777 permission broadening", ("chmod 777",), ()),
        ("sudo command in repository automation", ("sudo ",), ()),
    ]
    lowered = text.lower()
    for reason, required_any, paired_any in checks:
        if not any(token in lowered for token in required_any):
            continue
        if paired_any and not any(token in lowered for token in paired_any):
            continue
        return reason
    return None


def security_findings(directory):
    findings = []
    lifecycle_scripts = {
        "preinstall",
        "install",
        "postinstall",
        "prepublish",
        "prepublishonly",
        "prepare",
    }
    scanned_suffixes = {
        ".js", ".cjs", ".mjs", ".ts", ".tsx", ".jsx",
        ".py", ".sh", ".bash", ".zsh", ".fish", ".ps1",
        ".rb", ".php", ".pl", ".go", ".rs", ".yml", ".yaml",
        ".toml", ".json",
    }

    for path in sorted(directory.rglob("*")):
        rel = path.relative_to(directory)
        if ignored(rel) or not path.is_file():
            continue

        if path.name == "package.json":
            package = package_json(path.parent)
            scripts = package.get("scripts")
            if isinstance(scripts, dict):
                for name, command in sorted(scripts.items()):
                    if name.lower() in lifecycle_scripts:
                        findings.append(f"{rel}: npm lifecycle script '{name}' runs during install")
                    if isinstance(command, str):
                        reason = suspicious_text_reason(command)
                        if reason:
                            findings.append(f"{rel}: script '{name}' contains {reason}")

        if path.suffix.lower() not in scanned_suffixes and path.name not in {"Makefile", "Dockerfile"}:
            continue

        text = read_text_safely(path)
        if text is None:
            continue
        reason = suspicious_text_reason(text)
        if reason:
            findings.append(f"{rel}: {reason}")

    return findings


def has_any(directory, pattern):
    return any(directory.glob(pattern))


def requirement_files(directory):
    return sorted(
        path
        for path in directory.glob("*.txt")
        if path.name.startswith(("requirement", "requirements"))
    )


def is_dependency_manifest(path, repo_root, manifest_names):
    rel = path.relative_to(repo_root)
    if path.name in manifest_names:
        return True

    if (
        not path.name.startswith(("requirement", "requirements"))
        or path.suffix != ".txt"
    ):
        return False

    non_project_dirs = {
        "doc",
        "docs",
        "example",
        "examples",
        "fixture",
        "fixtures",
        "sample",
        "samples",
        "test",
        "tests",
    }
    if any(part.lower() in non_project_dirs for part in rel.parts[:-1]):
        return False

    return True


def package_json(directory):
    try:
        package = json.loads((directory / "package.json").read_text())
    except Exception:
        return {}
    return package if isinstance(package, dict) else {}


def pyproject_data(directory):
    if tomllib is None:
        return {}
    try:
        return tomllib.loads((directory / "pyproject.toml").read_text())
    except Exception:
        return {}


def env_hints(directory):
    candidates = []
    for name in [".env.example", ".env.sample", "example.env", "env.example"]:
        path = directory / name
        if not path.exists():
            continue
        text = read_text_safely(path, max_bytes=100_000)
        if not text:
            continue
        for line in text.splitlines():
            stripped = line.strip()
            if not stripped or stripped.startswith("#") or "=" not in stripped:
                continue
            key = stripped.split("=", 1)[0].strip()
            if key:
                candidates.append(key)
    return sorted(set(candidates))


def file_excerpt(path, max_chars=20_000):
    text = read_text_safely(path, max_bytes=max_chars * 2)
    if text is None:
        return {"path": str(path), "readable": False, "content": "", "truncated": False}
    truncated = len(text) > max_chars
    return {
        "path": str(path),
        "readable": True,
        "content": text[:max_chars],
        "truncated": truncated,
    }


def doc_files(directory):
    names = [
        "README.md",
        "README.rst",
        "README.txt",
        "docs/README.md",
        "CONTRIBUTING.md",
        "DEVELOPMENT.md",
        "INSTALL.md",
    ]
    return [directory / name for name in names if (directory / name).is_file()]


def executable_for_command(directory, name):
    if name == "flask" and (directory / ".venv/bin/flask").exists():
        return ".venv/bin/flask"
    if name == "python" and (directory / ".venv/bin/python").exists():
        return ".venv/bin/python"
    if name == "pip" and (directory / ".venv/bin/pip").exists():
        return ".venv/bin/pip"
    return name


def safe_doc_command(directory, line):
    stripped = line.strip()
    if not stripped or stripped.startswith(("#", "$$", ">")):
        return None
    if suspicious_text_reason(stripped):
        return None
    try:
        parts = shlex.split(stripped)
    except ValueError:
        return None
    if not parts:
        return None

    blocked_words = {
        "install",
        "test",
        "pytest",
        "unittest",
        "deploy",
        "publish",
        "release",
        "migrate",
        "reset",
        "destroy",
    }
    if any(part.lower() in blocked_words for part in parts):
        return None

    while parts and parts[0] in {"uv", "poetry", "pipenv"}:
        if len(parts) >= 3 and parts[1] == "run":
            parts = parts[2:]
            break
        return None

    command = parts[0]
    safe_script_names = {"start", "dev", "serve", "preview", "build"}
    if command in {"python", "python3"} and len(parts) >= 2:
        script = parts[1]
        if script.endswith(".py") and (directory / script).is_file():
            parts[0] = executable_for_command(directory, "python")
            return parts
        if script == "manage.py" and (directory / script).is_file() and "runserver" in parts:
            parts[0] = executable_for_command(directory, "python")
            return parts
    if command == "flask" and len(parts) >= 2 and parts[1] == "run":
        if any((directory / name).is_file() for name in ["app.py", "wsgi.py"]):
            parts[0] = executable_for_command(directory, "flask")
            if "--host" not in parts:
                parts.extend(["--host", "0.0.0.0"])
            return parts
    if command in {"npm", "pnpm"} and (directory / "package.json").is_file():
        if len(parts) >= 2 and parts[1] in safe_script_names:
            return parts
        if len(parts) >= 3 and parts[1] == "run" and parts[2] in safe_script_names:
            return parts
    if command == "yarn" and (directory / "package.json").is_file():
        if len(parts) >= 2 and parts[1] in safe_script_names:
            return parts
        if len(parts) >= 3 and parts[1] == "run" and parts[2] in safe_script_names:
            return parts
    if command == "bun" and (directory / "package.json").is_file():
        if len(parts) >= 2 and parts[1] in safe_script_names:
            return parts
        if len(parts) >= 3 and parts[1] == "run" and parts[2] in safe_script_names:
            return parts
    if command == "make" and len(parts) >= 2 and (directory / "Makefile").is_file():
        if parts[1] in safe_script_names | {"run"}:
            return parts
    if command == "go" and len(parts) >= 2 and parts[1] == "run" and (directory / "go.mod").exists():
        return parts
    if command == "cargo" and len(parts) >= 2 and parts[1] == "run" and (directory / "Cargo.toml").exists():
        return parts
    if command == "bundle" and len(parts) >= 4 and (directory / "Gemfile").is_file():
        if parts[1:4] == ["exec", "rails", "server"]:
            return parts
    if command == "ruby" and len(parts) >= 2 and (directory / "Gemfile").is_file():
        script = parts[1]
        if script.endswith(".rb") and (directory / script).is_file():
            return parts
    if command == "php" and len(parts) >= 2 and (directory / "composer.json").is_file():
        if parts[1] == "-S":
            return parts
    if command == "composer" and len(parts) >= 2 and (directory / "composer.json").is_file():
        if parts[1] in safe_script_names:
            return parts
    return None


def readme_smoke_commands(directory, log=True):
    commands = []
    seen = set()
    for path in doc_files(directory):
        rel = path.relative_to(directory)
        if log:
            print(f"DOCS_READ {rel}", flush=True)
        text = read_text_safely(path, max_bytes=200_000) or ""
        in_fence = False
        for raw_line in text.splitlines():
            line = raw_line.strip()
            if line.startswith("```"):
                in_fence = not in_fence
                continue
            if not in_fence:
                lowered = line.lower()
                if not any(token in lowered for token in ["run", "start", "serve", "python", "flask", "npm", "pnpm", "yarn", "bun", "go run", "cargo run", "make", "bundle", "ruby", "php", "composer"]):
                    continue
            command = safe_doc_command(directory, line)
            if not command:
                continue
            key = tuple(command)
            if key in seen:
                continue
            seen.add(key)
            if log:
                print(f"RUN_CANDIDATE docs {rel}: {' '.join(command)}", flush=True)
            commands.append((command, 30, True))
    return commands


def command_strings(commands):
    return [" ".join(command) for command, _timeout, _timeout_ok in commands]


def repo_profile(directory, manifests):
    docs = []
    for path in doc_files(directory):
        item = file_excerpt(path)
        item["path"] = str(path.relative_to(directory))
        docs.append(item)

    package = package_json(directory)
    scripts = package.get("scripts") if isinstance(package.get("scripts"), dict) else {}
    python_files = [str(path.relative_to(directory)) for path in candidate_python_files(directory)]

    return {
        "repo_path": str(directory),
        "files": file_inventory(directory),
        "docs": docs,
        "manifests": sorted(manifests),
        "manifest_contents": [
            dict(file_excerpt(directory / manifest, max_chars=10_000), path=manifest)
            for manifest in sorted(manifests)
            if (directory / manifest).is_file()
        ],
        "env_hints": env_hints(directory),
        "entrypoints": {
            "python": python_files,
            "node_scripts": scripts,
            "go": (directory / "go.mod").exists(),
            "rust": (directory / "Cargo.toml").exists(),
            "ruby": (directory / "Gemfile").exists(),
            "php": (directory / "composer.json").exists(),
            "make": (directory / "Makefile").exists(),
        },
        "readme_smoke_candidates": command_strings(readme_smoke_commands(directory, log=False)),
    }


def print_repo_profile(directory, manifests):
    print("REPO_PROFILE_JSON_BEGIN", flush=True)
    print(json.dumps(repo_profile(directory, manifests), sort_keys=True), flush=True)
    print("REPO_PROFILE_JSON_END", flush=True)


def python_module_candidates(directory):
    data = pyproject_data(directory)
    names = []

    flit_module = data.get("tool", {}).get("flit", {}).get("module", {}).get("name")
    if isinstance(flit_module, str):
        names.append(flit_module)

    project_name = data.get("project", {}).get("name")
    if isinstance(project_name, str):
        names.append(project_name.replace("-", "_"))

    src = directory / "src"
    if src.exists():
        for child in sorted(src.iterdir()):
            if child.is_dir() and (child / "__init__.py").exists():
                names.append(child.name)

    for child in sorted(directory.iterdir()):
        if child.is_dir() and (child / "__init__.py").exists() and child.name not in {"tests", "docs"}:
            names.append(child.name)

    deduped = []
    for name in names:
        if name.isidentifier() and name not in deduped:
            deduped.append(name)
    return deduped


def candidate_python_files(directory):
    preferred_names = {
        "main.py",
        "app.py",
        "server.py",
        "run.py",
        "cli.py",
        "manage.py",
        "__main__.py",
    }
    candidates = []
    for path in sorted(directory.rglob("*.py")):
        rel = path.relative_to(directory)
        if ignored(rel):
            continue
        text = read_text_safely(path, max_bytes=500_000) or ""
        score = 0
        if path.name in preferred_names:
            score += 100
        if "if __name__" in text and "__main__" in text:
            score += 80
        if any(token in text for token in ["FastAPI(", "Flask(", "click.group", "typer.Typer", "argparse.ArgumentParser"]):
            score += 20
        if score == 0:
            continue
        candidates.append((score, len(rel.parts), str(rel), path))

    return [item[3] for item in sorted(candidates, key=lambda item: (-item[0], item[1], item[2]))[:8]]


def print_discovery(directory):
    print(f"DISCOVERY_LS_BEGIN {directory}", flush=True)
    try:
        for child in sorted(directory.iterdir()):
            print(child.name, flush=True)
    except Exception as exc:
        print(f"DISCOVERY_LS_ERROR {type(exc).__name__}: {exc}", flush=True)
    print("DISCOVERY_LS_END", flush=True)

    for path in candidate_python_files(directory):
        print(f"RUN_CANDIDATE python {path.relative_to(directory)}", flush=True)

    package = package_json(directory)
    scripts = package.get("scripts") if isinstance(package.get("scripts"), dict) else {}
    for name, command in sorted(scripts.items()):
        if name in {"start", "dev", "serve", "preview", "build"}:
            print(f"RUN_CANDIDATE npm-script {name}: {command}", flush=True)


def python_runner(directory):
    uv = uv_command(directory)
    if uv and ((directory / "uv.lock").exists() or (directory / "pyproject.toml").exists()):
        return uv + ["run", "python"]
    if (directory / "poetry.lock").exists() and has("poetry"):
        return ["poetry", "run", "python"]
    if (directory / ".venv/bin/python").exists():
        return [".venv/bin/python"]
    if ensure_python_runtime(directory):
        return ["python3"]
    return None


def smoke_commands(directory):
    commands = []
    print_discovery(directory)
    if startup_command:
        commands.append((["sh", "-lc", startup_command], 30, True))
    commands.extend(readme_smoke_commands(directory))

    package = package_json(directory)
    scripts = package.get("scripts") if isinstance(package.get("scripts"), dict) else {}

    if (directory / "package.json").exists():
        manager = None
        if (directory / "pnpm-lock.yaml").exists():
            manager = "pnpm"
        elif (directory / "yarn.lock").exists():
            manager = "yarn"
        elif (directory / "bun.lockb").exists() or (directory / "bun.lock").exists():
            manager = "bun"
        else:
            manager = "npm"

        if not ensure_node_manager(manager, directory):
            missing_tool(manager)
        else:
            for script_name in ["build", "start", "dev", "serve", "preview"]:
                if script_name not in scripts:
                    continue
                if manager == "yarn":
                    command = ["yarn", script_name]
                elif manager == "npm" and script_name == "start":
                    command = ["npm", "start"]
                else:
                    command = [manager, "run", script_name]
                commands.append((command, 900 if script_name == "build" else 30, script_name != "build"))

    runner = python_runner(directory)
    if runner:
        for module in python_module_candidates(directory):
            commands.append(
                (
                    runner + ["-c", f"import {module}; print('SMOKE_IMPORT_OK {module}')"],
                    60,
                    False,
                )
            )
            break

        for path in candidate_python_files(directory):
            commands.append((runner + [str(path.relative_to(directory))], 30, True))

    if (directory / "go.mod").exists() and ensure_go_runtime(directory):
        commands.append((["go", "run", "."], 30, True))
    if (directory / "Cargo.toml").exists() and ensure_rust_runtime(directory):
        commands.append((["cargo", "run"], 30, True))

    return commands


manifest_names = {
    "package.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock", "bun.lock", "bun.lockb",
    "pyproject.toml", "uv.lock", "Pipfile", "poetry.lock", "environment.yml",
    "go.mod", "Cargo.toml", "Gemfile", "composer.json",
}


def collect_manifests(directory):
    found_manifests = []
    found_install_dirs = set()
    for path in directory.rglob("*"):
        rel = path.relative_to(directory)
        if ignored(rel) or not path.is_file():
            continue
        if is_dependency_manifest(path, directory, manifest_names):
            found_manifests.append(str(rel))
            found_install_dirs.add(path.parent)
    return found_manifests, found_install_dirs


